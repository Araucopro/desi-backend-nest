{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": ".*\\.integration-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "globalSetup": "<rootDir>/src/test/global-setup.ts",
  "setupFiles": ["<rootDir>/src/test/setup-env.ts"],
  "testTimeout": 120000,
  "maxWorkers": 1
}
