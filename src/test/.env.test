# Entorno de los tests de integración (test/jest-integration.json).
# Valores alineados con el servicio `db` de docker-compose.yml.
PGOWNERHOST=127.0.0.1
PGOWNERPORT=5433
PGOWNERUSER=postgres
PGOWNERPASSWORD=postgres
PGDATABASE=d3si_test

# Deja PG_RUNTIME_USER vacío para conectar la aplicación con el mismo rol que
# corre las migraciones. Con un rol distinto (por ejemplo `app_runtime`) el
# arnés habilita RLS sobre las tablas de caja: la app pasa a estar sujeta a las
# políticas y las sentencias no cualificadas por tenant devuelven 0 filas.
PG_RUNTIME_USER=postgres
PG_RUNTIME_PASSWORD=postgres

JWT_SECRET=integration-test-secret
JWT_EXPIRES_IN=1h
STORE_ENCRYPTION_KEY=616785b38569ef211e2b5316c163dfd49dfda31b6522709bdbf7bfa741858411
