PGDATABASE=name
PGUSER=user
PGPASSWORD=password
PGPORT=9999
PGHOST=host.host
JWT_SECRET=super-secret-key
JWT_EXPIRES_IN=24h
DATABASE_URL=
PG_OWNER_USER=postgres
PG_RUNTIME_USER=app_runtime
PG_RUNTIME_PASSWORD=
PG_OWNER_PASSWORD=
PG_APP_NAME=araucopro-api
# Runtime pool limits (also applied when using DATABASE_URL).
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
# Server-side cancellation, in ms. Zero disables the corresponding SQL timeout.
PG_STATEMENT_TIMEOUT_MS=30000
PG_LOCK_TIMEOUT_MS=10000
PG_IDLE_TRANSACTION_TIMEOUT_MS=60000
RLS_ENABLED=true
# La API key de Openfactura se configura por tienda en la base de datos
# mediante PATCH /stores/:id/openfactura-key (nunca en variables de entorno)
OPENFACTURA_BASE_URL=https://dev-api.haulmer.com
# Timeout para la consulta/descarga de documentos emitidos (pdf/xml/cedible
# pueden generar el documento al momento). Las llamadas de emisión/reconciliación
# conservan el timeout estándar de 15 s.
OPENFACTURA_DOWNLOAD_TIMEOUT_MS=60000
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORE_ENCRYPTION_KEY=
